<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pivotos</groupId>
    <artifactId>pivotos-framework</artifactId>
    <version>2.16.1</version>
    <packaging>pom</packaging>

    <name>pivotos-framework</name>
    <description>PivotOS 后端框架聚合父工程</description>

    <modules>
        <module>pivotos-dependencies</module>
        <module>pivotos-commons</module>
        <module>pivotos-starters</module>
        <module>pivotos-plugins</module>
        <module>pivotos-admin-server</module>
        <!-- V3-S2 L2：Spring Cloud Gateway（webmvc 变体）独立进程，单体形态不启动 -->
        <module>pivotos-gateway-server</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- V3-S2 第二轮：Spring Boot 版本仲裁点（由 pivotos-dependencies 上移到这里）。
             上移原因：spring-boot-maven-plugin 必须在 pluginManagement 里显式钉版本，
             而父 pom 读不到子模块（pivotos-dependencies）的 property —— 若不钉，Maven 会
             「自由取版本」把 fat jar 打成 milestone 插件产物（实测混入 jarmode-tools-4.2.0-M2）。
             本项目全仓仅此一处声明 Boot 版本，子模块与 BOM 一律继承，勿在其他 pom 重复声明。 -->
        <spring-boot.version>4.1.1</spring-boot.version>

        <!-- Lombok：JDK 25 需 >= 1.18.40；JDK 23+ 必须配合 annotationProcessorPaths 显式开启 -->
        <lombok.version>1.18.44</lombok.version>

        <!-- 插件版本统一锁定 -->
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>

        <!-- 与 pivotos-dependencies 中 mapstruct-plus.version 保持一致（annotationProcessorPaths 无法引用 import BOM 的属性） -->
        <mapstruct-plus.version>1.5.1</mapstruct-plus.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <!-- 保留方法参数名（@RequestParam 省略 name、Lock4j/SpEL 参数引用依赖此项） -->
                        <parameters>true</parameters>
                        <!-- JDK 23+ javac 不再默认扫描 classpath 上的注解处理器，必须显式声明 -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <!-- Lombok 与 MapStruct 协同（mapstruct-plus 底层是 MapStruct） -->
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>0.2.0</version>
                            </path>
                            <path>
                                <groupId>io.github.linpeilie</groupId>
                                <artifactId>mapstruct-plus-processor</artifactId>
                                <version>${mapstruct-plus.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <!-- 必须显式钉版本且与 ${spring-boot.version} 一致：缺省时 Maven 会取到 milestone
                         版本（实测 4.2.0-M2），fat jar 的 loader/jarmode 与运行态 runtime 不同源。
                         admin-server 声明处不写 <version>，继承这里。 -->
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <!-- 部署/安装 BOM 时把 ${revision} 类占位符展开，保证下游可解析 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- 显式声明 maven-compiler-plugin 使所有子模块继承：
             IDEA 对 pluginManagement 中的 annotationProcessorPaths 导入支持不佳，
             显式声明后 IDEA 才能正确启用 Lombok/MapStruct 注解处理，避免生成坏字节码 -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
