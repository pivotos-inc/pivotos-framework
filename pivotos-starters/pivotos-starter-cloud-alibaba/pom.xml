<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pivotos</groupId>
        <artifactId>pivotos-starters</artifactId>
        <version>2.16.1</version>
    </parent>

    <artifactId>pivotos-starter-cloud-alibaba</artifactId>

    <name>pivotos-starter-cloud-alibaba</name>
    <description>ST-CLOUD Spring Cloud Alibaba 通道：Nacos 注册发现（官方 SDK）+ Sentinel 流量治理</description>

    <dependencies>
        <!-- 契约包 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-cloud-api</artifactId>
        </dependency>

        <!-- Nacos 注册发现（SCA 2025.1.0.0 带 nacos-client 3.1.1）。
             刻意不引 spring-cloud-starter-alibaba-nacos-config：它要求
             spring.config.import 必须声明 nacos dataId，是启动硬门槛，
             与「单体形态零配置 fat jar 直起」冲突（配置中心另开一轮）。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- Sentinel 流量治理 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
