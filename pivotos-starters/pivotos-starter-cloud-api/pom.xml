<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pivotos</groupId>
        <artifactId>pivotos-starters</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>pivotos-starter-cloud-api</artifactId>

    <name>pivotos-starter-cloud-api</name>
    <description>ST-CLOUD 契约包：三通道（local / cloud / alibaba）SPI + 服务发现抽象 + 身份与租户上下文传播（零第三方中间件依赖）</description>

    <dependencies>
        <!-- 上下文载体 LoginUser（跨进程序列化的最小身份快照） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-common-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-common-core</artifactId>
        </dependency>

        <!-- LoginContext / TenantContext / TraceContext（ScopedValue 体系，项目唯一上下文入口） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-core</artifactId>
        </dependency>

        <!-- Spring 能力（@ConfigurationProperties / AutoConfiguration / FilterRegistrationBean）；
             optional 只影响传递，下游必为 Spring Boot 应用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- spring-web：OncePerRequestFilter 所在（spring-boot-starter 不含 web，需显式补） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- spring-webmvc：Facade HTTP 端点的编程式 MVC 映射注册（RequestMappingHandlerMapping）需要。
             optional + @ConditionalOnClass(name=...) 双保险：非 MVC 应用即便引了本模块也不会被拖累，
             与 starter-datainspect 里 optional Redisson 的做法同款。
             注意：正因为这是「可选能力」，端点类才刻意不标 @RestController——
             那样就变成组件扫描说了算，开关会失效（详见 FacadeHttpHandler 注释）。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Feign：出站身份/租户传播拦截器（V3-S3 由 starter-cloud 下沉而来）。
             为什么要下沉到本模块：cloud 与 alibaba 是互斥的两个 Maven profile，
             -P alibaba 的包里没有 starter-cloud 的任何类 —— 拦截器放在实现模块里，
             等于 alibaba 形态永远装配不到（真机症状：Feign 全调通，但身份头一个都没发）。
             optional + @ConditionalOnClass(name="feign.Feign") 与 spring-webmvc 同款口径：
             编译期可见、不传递给消费方、默认形态无 feign 时自动跳过。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Servlet API：入站恢复 Filter 需要；provided 不进运行时 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JSON：Facade HTTP 端点的参数/返回值 marshalling。
             刻意用 Jackson 2（com.fasterxml）而非容器主用的 Jackson 3（tools.jackson）：
             反射调用的动态类型反序列化在 Jackson 2 上最稳，且两者包名不同可共存
             （版本由 BOM 钉，与 starter-cloud-local 的 JsonSupport 同款做法）。
             optional：本模块契约层不强制把 JSON 栈带给消费方。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson 2 数据类型模块（V3-S4 D2）：
             为什么必须显式声明而不能靠 findAndRegisterModules() 撞运气：
             ① Boot 4 世代主用的是 Jackson 3（tools.jackson），Jackson 2 的 datatype 模块
                很可能根本不在运行时 classpath 上；而 findAndRegisterModules() 是 ServiceLoader
                静默发现，缺模块不报错，只在遇到 LocalDateTime / Optional 时才炸
                （实测预判：IMessageFacade#pageByUser 的 MessageDTO.readTime 会直接 500）。
             ② 「依赖碰巧在 classpath」不是契约：显式声明 + 单测钉死序列化形态，
                才不会在某个 profile（-P alibaba / -P cloud）的包里悄悄退化。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试期才需要完整 Web 栈（Tomcat + MVC），用于「真起端口跑一次 HTTP 往返」。
             test scope 不进发布的 jar、不进 fat jar，因此不影响「契约层零框架依赖」的交付口径。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
