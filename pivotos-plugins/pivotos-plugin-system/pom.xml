<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pivotos</groupId>
        <artifactId>pivotos-plugins</artifactId>
        <version>2.9.0</version>
    </parent>

    <artifactId>pivotos-plugin-system</artifactId>

    <name>pivotos-plugin-system</name>
    <description>PivotOS system 插件实现（用户/角色/菜单/部门/字典/参数 + 登录认证）</description>

    <dependencies>
        <!-- 本插件契约 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-system-api</artifactId>
        </dependency>

        <!-- 底座契约与 Starter -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-redis</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 对象转换（BOM 已仲裁，SB4 下注解处理器可用、注入需单测验证） -->
        <dependency>
            <groupId>io.github.linpeilie</groupId>
            <artifactId>mapstruct-plus-spring-boot-starter</artifactId>
        </dependency>

        <!-- BCrypt 密码哈希（BOM 已仲裁） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 操作日志 @Log 切面（S26 2.1-F1）：SB4 BOM 已移除 spring-boot-starter-aop，
             @Aspect 自动代理仅需 aspectjweaver（版本由 SB BOM 仲裁） -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- Excel 导入导出（S27 2.1-F8/F9）：@DictExcelProperty 注解 + ExcelHelper -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-excel</artifactId>
        </dependency>

        <!-- 数据权限（S30 2.1-F10/F11）：@DataScope 注解 + SQL 行级过滤拦截器 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-datascope</artifactId>
        </dependency>

        <!-- 任务调度（S34 2.2-F6/F7）：XXL-Job 自动装配 + 默认任务 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-job</artifactId>
        </dependency>

        <!-- Redisson 客户端（在线用户会话扫描，transitive via sa-token-redisson） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
