<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pivotos</groupId>
        <artifactId>pivotos-framework</artifactId>
        <version>2.12.0</version>
    </parent>

    <artifactId>pivotos-plugins</artifactId>
    <packaging>pom</packaging>

    <name>pivotos-plugins</name>
    <description>PivotOS 业务插件聚合层（system 等可插拔业务模块）</description>

    <modules>
        <module>pivotos-plugin-system-api</module>
        <module>pivotos-plugin-system</module>
        <module>pivotos-plugin-message-api</module>
        <module>pivotos-plugin-message</module>
        <module>pivotos-plugin-file-api</module>
        <module>pivotos-plugin-file</module>
        <module>pivotos-plugin-ai-api</module>
        <module>pivotos-plugin-ai</module>
        <module>pivotos-plugin-generator-api</module>
        <module>pivotos-plugin-generator</module>
        <module>pivotos-plugin-ai-coding-api</module>
        <module>pivotos-plugin-ai-coding</module>
        <module>pivotos-plugin-monitor</module>
        <module>pivotos-plugin-workflow-api</module>
        <module>pivotos-plugin-workflow</module>
        <module>pivotos-plugin-ai-kb-api</module>
        <module>pivotos-plugin-ai-kb</module>
        <module>pivotos-plugin-docsync-api</module>
        <module>pivotos-plugin-docsync</module>
        <module>pivotos-plugin-migration-api</module>
        <module>pivotos-plugin-migration</module>
        <module>pivotos-plugin-mind-api</module>
        <module>pivotos-plugin-mind</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Swagger/OpenAPI 注解（@Tag/@Operation/@Schema）提供给所有插件编译使用，版本由 BOM 统一管理 -->
    <dependencies>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
