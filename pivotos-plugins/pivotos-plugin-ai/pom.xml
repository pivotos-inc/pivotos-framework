<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pivotos</groupId>
        <artifactId>pivotos-plugins</artifactId>
        <version>2.16.1</version>
    </parent>

    <artifactId>pivotos-plugin-ai</artifactId>

    <name>pivotos-plugin-ai</name>
    <description>PivotOS ai 插件实现（AI 助手：多轮对话/SSE 流式/会话持久化；RAG/Agent/MCP 后续在此扩展）</description>

    <dependencies>
        <!-- 本插件契约 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-ai-api</artifactId>
        </dependency>

        <!-- 跨插件契约：Key 健康度告警发站内信（只依赖 -api，禁依赖实现模块） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-message-api</artifactId>
        </dependency>

        <!-- 跨插件契约：RAG 知识库检索（S59 对话集成知识库上下文） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-ai-kb-api</artifactId>
        </dependency>

        <!-- 跨插件契约：用量看板用户名回填（S92，只依赖 -api） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-system-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 跨插件契约：A2 工具查当前用户待办数（S97 Hello World，只依赖 -api） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-workflow-api</artifactId>
        </dependency>

        <!-- 底座契约与 Starter -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-auth</artifactId>
        </dependency>
        <!-- 任务调度（S34 2.2-F7）：AI Key 健康度巡检 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-job</artifactId>
        </dependency>

        <!-- AI 底座：ChatClient / AiProperties -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-ai</artifactId>
        </dependency>

        <!-- S46 2.3-F2：非 OpenAI 供应商接入（按 provider.code 分派，落点 plugin-ai，
             starter-ai 保持「静态兜底 openai」单一职责；版本由 spring-ai-bom 托管）
             排除 swagger-annotations（非 jakarta），避免与 swagger-annotations-jakarta 2.2.47 冲突（$dynamicRef 缺失） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.swagger.core.v3</groupId>
                    <artifactId>swagger-annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>

        <!-- S97 A2 前置：MCP Server（WebMVC SSE）——@Tool 方法经 ToolCallbackProvider
             同时供 MCP 端点与对话链路 tools 挂载（版本由 spring-ai-bom 托管） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- S112 A4-3：ToolObjectContributor 扩展点装配测试（静默失效风险须用例锁死） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
