<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pivotos</groupId>
        <artifactId>pivotos-plugins</artifactId>
        <version>2.2.0</version>
    </parent>

    <artifactId>pivotos-plugin-ai</artifactId>

    <name>pivotos-plugin-ai</name>
    <description>PivotOS ai 插件实现（AI 助手：多轮对话/SSE 流式/会话持久化；RAG/Agent/MCP 后续在此扩展）</description>

    <dependencies>
        <!-- 本插件契约 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-ai-api</artifactId>
        </dependency>

        <!-- 跨插件契约：Key 健康度告警发站内信（只依赖 -api，禁依赖实现模块） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-message-api</artifactId>
        </dependency>

        <!-- 底座契约与 Starter -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-auth</artifactId>
        </dependency>
        <!-- 任务调度（S34 2.2-F7）：AI Key 健康度巡检 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-job</artifactId>
        </dependency>

        <!-- AI 底座：ChatClient / AiProperties -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-ai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>
</project>
