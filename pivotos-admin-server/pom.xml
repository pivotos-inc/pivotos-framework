<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pivotos</groupId>
        <artifactId>pivotos-framework</artifactId>
        <version>2.15.0</version>
    </parent>

    <artifactId>pivotos-admin-server</artifactId>

    <name>pivotos-admin-server</name>
    <description>PivotOS 单体启动器：装配全部 Starter 与业务 Plugin</description>

    <dependencies>
        <!-- ===== Web 基础（SB4 新 artifactId） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- ===== 五个核心 Starter（显式装配，增删依赖 0 改动验证的对象） ===== -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-auth</artifactId>
        </dependency>
        <!-- tenant Starter：默认关闭（pivotos.tenant.enabled 不写=单租户），装配开关验证对象 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-tenant</artifactId>
        </dependency>
        <!-- excel Starter：EasyExcel 4.x 流式导入导出 + 字典翻译 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-excel</artifactId>
        </dependency>
        <!-- search Starter（S121）：主 Starter（含 simple 内存兜底）+ es-java 实现（ES 8.x/9.x）。
             S121-D2 的「只引主 Starter」在真接 ES 时按约定放开这一行：dev/test 已配 ES 地址
             （175.24.176.176 / 10.0.0.7），type=es-java 时走真 ES；未配或连不上时检索自动回退数据库查询，
             业务不受影响。es-java 与 easy-es 两个实现模块绝不可同时引入（同一 GA 坐标版本互斥）。 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-search</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-search-es-java</artifactId>
        </dependency>
        <!-- datainspect Starter（S130）：通用数据监控（DB/ES/Redis）+ SQL 安全闸门。
             主 Starter 已含 MySQL 实现；Redis / ES 实现由后续 Sprint 引入对应模块（-redis / -es）。 -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-starter-datainspect</artifactId>
        </dependency>

        <!-- ===== 业务 Plugin（system-api/message-api 由 plugin 传递带入） ===== -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-message</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-file</artifactId>
        </dependency>
        <!-- ai 插件（自带 starter-ai / plugin-ai-api 传递依赖） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-ai</artifactId>
        </dependency>
        <!-- generator 插件（代码生成器） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-generator</artifactId>
        </dependency>
        <!-- ai-coding 插件（AI 自然语言 → 单表 CRUD） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-ai-coding</artifactId>
        </dependency>
        <!-- monitor 插件（S48 2.3-F6：服务监控 oshi/JMX + 缓存监控 Redis INFO，无表结构） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-monitor</artifactId>
        </dependency>
        <!-- workflow 插件（S55 2.5-F1：WarmFlow 工作流引擎底座） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-workflow</artifactId>
        </dependency>
        <!-- ai-kb 插件（S58 2.5-F4：RAG 知识库） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-ai-kb</artifactId>
        </dependency>
        <!-- docsync 插件（API 文档多平台同步：Torna/YApi/Apifox/ShowDoc/XXL-API） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-docsync</artifactId>
        </dependency>
        <!-- migration 插件（旧系统迁移助手） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-migration</artifactId>
        </dependency>
        <!-- mind 插件（PivotOS·智域个人端：知识库 + 智能待办） -->
        <dependency>
            <groupId>com.pivotos</groupId>
            <artifactId>pivotos-plugin-mind</artifactId>
        </dependency>

        <!-- ===== API 文档（Knife4j Next：SB4 兼容增强 UI；jakarta 变体适配 SB4 的 jakarta.servlet） ===== -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <!-- Swagger Core 注解：显式锁定 2.2.47，避免 knife4j/springdoc 传递依赖残留 2.2.38（$dynamicRef 缺失） -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.47</version>
        </dependency>
        <!-- 非 jakarta 变体也锁定 2.2.47（anthropic-java-core 传递依赖旧版 2.2.31） -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>2.2.47</version>
        </dependency>

        <!-- ===== 运行时驱动（plugin 中为 test 作用域，启动器必须自带） ===== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== 测试：ArchUnit A1-A7 规则集宿主（本模块聚合全部 Starter/Plugin） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>pivotos-admin-server</finalName>
        <plugins>
            <!-- 打可执行 fat jar，为 S18 单体 JAR 部署做准备 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.pivotos.server.PivotOsAdminApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
