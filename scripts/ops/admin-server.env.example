# PivotOS Admin Server · 环境变量模板（V3.1-G · P1-B3 进程托管）
#
# 用法：
#   cp scripts/ops/admin-server.env.example /etc/pivotos/admin-server.env
#   chmod 600 /etc/pivotos/admin-server.env      # 含口令，权限必须收紧
#   vi /etc/pivotos/admin-server.env             # 填真实值
#
# ⚠️ 铁律：
#   1. 本文件**只有键、没有值**，仅作为清单；真实口令由密钥管理系统或部署平台注入。
#   2. 填好的 admin-server.env **绝不能**提交进 Git（.gitignore 已排除 /etc 之外的副本，
#      但若你在仓库目录内生成副本，请确认它不在 git status 里）。
#   3. 变量名必须与代码里的占位符**逐字**一致：Spring 不做别名映射，
#      写错名字的表现是「配了不生效且完全不报错」——这是本项目踩过两次的坑。
#      本清单由 scripts/ops/check_env_var_docs.py 从代码自动比对，跑回归即可发现漂移。
#
# 格式：systemd EnvironmentFile 只认 KEY=VALUE，不支持引号与变量展开。
#      值里不要加引号，不要写 `export`，等号两侧不要有空格。

# ===== 必需（prod profile 缺一即拒绝启动）=====
PIVOTOS_MYSQL_URL=
PIVOTOS_MYSQL_USERNAME=
PIVOTOS_MYSQL_PASSWORD=
PIVOTOS_REDIS_HOST=
PIVOTOS_REDIS_PASSWORD=
PIVOTOS_FIELD_ENCRYPT_KEY=

# ===== 建议（不填则用代码默认值，生产建议显式给）=====
# 日志滚动目录；不填则是「相对进程工作目录」的 logs/
PIVOTOS_LOG_DIR=
PIVOTOS_LOG_FILE_NAME=
PIVOTOS_LOG_MAX_FILE_SIZE=
PIVOTOS_LOG_MAX_HISTORY=
PIVOTOS_LOG_TOTAL_SIZE_CAP=

# AI 能力（不注入则 AI 不可用；prod 无兜底）
PIVOTOS_LLM_API_KEY=

# 对象存储 COS
PIVOTOS_COS_ACCESS_KEY=
PIVOTOS_COS_SECRET_KEY=

# XXL-Job 执行器与调度中心通信令牌
PIVOTOS_XXL_JOB_ACCESS_TOKEN=

# 检索（ES）
PIVOTOS_SEARCH_TYPE=
PIVOTOS_ES_JAVA_URIS=
PIVOTOS_ES_JAVA_USERNAME=
PIVOTOS_ES_JAVA_PASSWORD=
PIVOTOS_ES_JAVA_COMPATIBILITY_MODE=
PIVOTOS_ES_JAVA_REFRESH_ON_WRITE=
PIVOTOS_SEARCH_INDEX_PREFIX=
PIVOTOS_SEARCH_KB_DOC_ENABLED=
PIVOTOS_SEARCH_KB_CHUNK_ENABLED=
PIVOTOS_SEARCH_OPER_LOG_ENABLED=

# 指标与 Prometheus 抓取端点（V3.1-F）
PIVOTOS_METRICS_ENABLED=
PIVOTOS_METRICS_PROMETHEUS_ENABLED=
PIVOTOS_METRICS_PROMETHEUS_PATH=
PIVOTOS_METRICS_SLOW_REQUEST_ENABLED=
PIVOTOS_METRICS_SLOW_REQUEST_THRESHOLD_MS=

# 数据监控闸门（S130）
PIVOTOS_DATA_INSPECT_ENABLED=
PIVOTOS_DATA_INSPECT_QUERY_ENABLED=
PIVOTOS_DATA_INSPECT_ALLOW_ALL_TABLES=
PIVOTOS_DATA_INSPECT_TABLE_WHITELIST=
PIVOTOS_DATA_INSPECT_SCHEMA_WHITELIST=

# 匿名访问闸门（V3.1-D · A4）
PIVOTOS_AUTH_GUARD_ENABLED=
PIVOTOS_AUTH_GUARD_PATHS=
PIVOTOS_AUTH_GUARD_EXCLUDE_PATHS=
PIVOTOS_AUTH_GUARD_MESSAGE=

# 迁移引擎工作区
PIVOTOS_MIGRATION_WORKSPACE=

# 小程序
PIVOTOS_MIND_MINIAPP_APPID=
PIVOTOS_MIND_MINIAPP_SECRET=

# 其它
PIVOTOS_API_DOCS_ENABLED=
PIVOTOS_KB_VECTOR_STORE_TYPE=
PIVOTOS_WORKFLOW_LEGACY_DESIGNER_ENABLED=

# ===== 微服务形态（仅 -P cloud / -P alibaba 打进 fat jar 才生效）=====
PIVOTOS_CLOUD_ENABLED=
PIVOTOS_CLOUD_PROVIDER=
PIVOTOS_CLOUD_INTERNAL_TOKEN=
PIVOTOS_CLOUD_LOCAL_PROXIED=
PIVOTOS_CLOUD_LOCAL_SERVER_ENABLED=
PIVOTOS_CLOUD_SC_PROXIED=
PIVOTOS_CLOUD_SC_URL=
PIVOTOS_CLOUD_SC_SERVICE_ID=
PIVOTOS_CLOUD_SC_CB_ENABLED=
PIVOTOS_CLOUD_SC_CB_FAILURE_RATE=
PIVOTOS_CLOUD_SC_CB_FALLBACK_MODE=
PIVOTOS_CLOUD_SC_CB_GRANULARITY=
PIVOTOS_CLOUD_SC_CB_HALF_OPEN_CALLS=
PIVOTOS_CLOUD_SC_CB_MIN_CALLS=
PIVOTOS_CLOUD_SC_CB_WAIT=
PIVOTOS_CLOUD_SC_CB_WINDOW=
PIVOTOS_NACOS_SERVER_ADDR=
PIVOTOS_NACOS_USERNAME=
PIVOTOS_NACOS_PASSWORD=
PIVOTOS_NACOS_NAMESPACE=
PIVOTOS_NACOS_GROUP=
PIVOTOS_NACOS_CONFIG_ENV=
PIVOTOS_NACOS_DISCOVERY_ENABLED=

# ===== JVM 参数（由 jvm-opts.sh 消费，见该文件）=====
JAVA_XMS=
JAVA_XMX=
JAVA_MAX_RAM_PERCENTAGE=
JAVA_EXIT_ON_OOM=
JAVA_OPTS=

# ===== OCR / JNA（缺少会导致 OCR 与上传报 1500）=====
TESSDATA_PREFIX=
JNA_LIBRARY_PATH=

# ===== 部署布局 =====
SERVER_PORT=
START_TIMEOUT_SECONDS=
TERM_TIMEOUT_SECONDS=
PIVOTOS_PROFILE=
