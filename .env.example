# 复制为 .env.dev 后按本机实际修改；.env.dev 已在 .gitignore 中，严禁提交真实凭据。
# docker-compose.dev.yml（中间件）使用：
MYSQL_ROOT_PASSWORD=mysql_change_me
REDIS_PASSWORD=redis_change_me
MINIO_ROOT_USER=pivotos
MINIO_ROOT_PASSWORD=minio_change_me
XXL_JOB_ACCESS_TOKEN=
# XXL-Job admin 中执行器组 ID（执行器首次注册后在 admin UI 查看填入）
XXL_JOB_GROUP_ID=1
# 阿里云百炼 DashScope API Key（AI 对话能力；不配则 AI 端点返回 5020）
DASHSCOPE_API_KEY=
# 应用启动（application-*.yml 从环境变量读取，仓库内不保留真实凭据）：
# MYSQL_PASSWORD / REDIS_PASSWORD 填应用实际连接库的密码（直连中间件时一般与 ROOT 密码同值）
MYSQL_PASSWORD=mysql_change_me
# 腾讯云 COS 文件存储（不配则文件上传不可用）
PIVOTOS_COS_ACCESS_KEY=
PIVOTOS_COS_SECRET_KEY=
# 集成测试（starter-tenant IT / plugin IT / rebuild-test-dbs.jsh / e2e 脚本）：
PIVOTOS_TEST_MYSQL_PASSWORD=mysql_change_me
PIVOTOS_TEST_REDIS_PASSWORD=redis_change_me
# PivotOS·智域小程序（开源样板间）AppID/Secret，仅微信一键登录需要
PIVOTOS_MIND_MINIAPP_APPID=
PIVOTOS_MIND_MINIAPP_SECRET=
