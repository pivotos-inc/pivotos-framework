<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pivotos</groupId>
        <artifactId>pivotos-framework</artifactId>
        <version>2.0.0</version>
    </parent>

    <artifactId>pivotos-dependencies</artifactId>
    <packaging>pom</packaging>

    <name>pivotos-dependencies</name>
    <description>PivotOS BOM：全项目第三方版本唯一仲裁点</description>

    <properties>
        <!-- ==================== 核心框架 ==================== -->
        <spring-boot.version>4.1.0</spring-boot.version>

        <!-- ==================== 持久层 ==================== -->
        <!-- SB4 专属 artifactId，勿用 SB3 旧 starter -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <jsqlparser.version>4.9</jsqlparser.version>
        <druid.version>1.2.28</druid.version>
        <!-- SB4 专属构件 dynamic-datasource-spring-boot4-starter：4.5.0 起适配 SB4
             （@AutoConfigureBefore 已覆盖 druid boot4 包名，exclude 规避与 TypeNotPresentException 告警同步消除） -->
        <dynamic-datasource.version>4.5.0</dynamic-datasource.version>
        <mysql-connector.version>9.7.0</mysql-connector.version>

        <!-- ==================== 认证 / 缓存 ==================== -->
        <sa-token.version>1.45.0</sa-token.version>
        <redisson.version>4.6.1</redisson.version>
        <lock4j.version>2.2.7</lock4j.version>

        <!-- ==================== 工具与序列化 ==================== -->
        <!-- Lombok：JDK 25 需 >= 1.18.40；JDK 23+ 必须配合 annotationProcessorPaths 显式开启 -->
        <lombok.version>1.18.44</lombok.version>
        <!-- fastjson2 必须 >= 2.0.61（2.0.5x 有已知 ASM 缺陷） -->
        <fastjson2.version>2.0.61</fastjson2.version>
        <!-- Jackson 2 兼容层：SB4 默认 Jackson 3，Sa-Token 仍依赖 Jackson 2，补齐 jsr310 时间模块 -->
        <jackson2.version>2.21.4</jackson2.version>
        <mapstruct-plus.version>1.5.1</mapstruct-plus.version>
        <hutool.version>5.8.47</hutool.version>

        <!-- ==================== 文档 / 任务 / 存储 ==================== -->
        <springdoc.version>3.0.3</springdoc.version>
        <xxl-job.version>3.4.2</xxl-job.version>
        <minio.version>9.0.3</minio.version>
        <okhttp.version>5.3.2</okhttp.version>
        <aws-sdk-v2.version>2.49.3</aws-sdk-v2.version>

        <!-- ==================== Excel 导入导出（EasyExcel 4.x 流式） ==================== -->
        <easyexcel.version>4.0.2</easyexcel.version>

        <!-- ==================== 搜索（Easy-ES 锁定 ES 7.17.28） ==================== -->
        <easy-es.version>3.0.2</easy-es.version>
        <elasticsearch.version>7.17.28</elasticsearch.version>

        <!-- ==================== AI（Spring AI 2.0：SB4.1/SF7/Jackson3 原生适配；
             SAA 1.1.2.0 仅支持 SB3.5，待其发布 SB4 版后再评估换装编排层） ==================== -->
        <spring-ai.version>2.0.0</spring-ai.version>

        <!-- ==================== 测试 ==================== -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <archunit.version>1.4.2</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- ========== Spring Boot 官方 BOM（import 方式，版本仲裁底座） ========== -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== MyBatis-Plus（SB4 专属 starter） ========== -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
            </dependency>

            <!-- ========== Druid（SB4 专属 starter） ========== -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-4-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- ========== dynamic-datasource ========== -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot4-starter</artifactId>
                <version>${dynamic-datasource.version}</version>
            </dependency>

            <!-- ========== MySQL 驱动 ========== -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>

            <!-- ========== Sa-Token ========== -->
            <!-- TODO(S5/S6): SB4 下确认是否有 sa-token-spring-boot4-starter；
                 没有则先用 SB3 starter + 兼容性验证，必要时薄封装并记技术债 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redisson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- Redisson 核心包必须与 starter 同版本锁定，防止 sa-token-redisson / lock4j 传递进来的旧核心包抢占仲裁 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- ========== Redisson / Lock4j ========== -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>lock4j-redisson-spring-boot-starter</artifactId>
                <version>${lock4j.version}</version>
            </dependency>

            <!-- ========== Lombok（provided，编译期增强，不进运行时包） ========== -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
                <optional>true</optional>
            </dependency>

            <!-- ========== fastjson2（含 Spring6 扩展） ========== -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2-extension-spring6</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson2.version}</version>
            </dependency>

            <!-- ========== MapStruct-Plus ========== -->
            <dependency>
                <groupId>io.github.linpeilie</groupId>
                <artifactId>mapstruct-plus-spring-boot-starter</artifactId>
                <version>${mapstruct-plus.version}</version>
            </dependency>

            <!-- ========== Hutool ========== -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- ========== SpringDoc ========== -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- ========== XXL-Job ========== -->
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>

            <!-- ========== 对象存储：MinIO / AWS SDK v2 ========== -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!-- minio 9.x 依赖 okhttp 5（KMP 元数据包），Maven 必须显式引 okhttp-jvm 才有真实类 -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>s3</artifactId>
                <version>${aws-sdk-v2.version}</version>
            </dependency>

            <!-- ========== EasyExcel 4.x 流式 ========== -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>

            <!-- ========== Easy-ES：锁定 ES 7.17.28，防止与 Spring Data ES 冲突 ========== -->
            <dependency>
                <groupId>org.dromara.easy-es</groupId>
                <artifactId>easy-es-boot-starter</artifactId>
                <version>${easy-es.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch</groupId>
                <artifactId>elasticsearch</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-high-level-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>

            <!-- ========== Spring AI（BOM import：openai-starter 走 DashScope 兼容模式接百炼） ========== -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== 测试 ========== -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- ========== 本项目内部模块（随会话推进逐个取消注释） ========== -->
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-common-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-excel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-datascope</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-plugin-system-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-plugin-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-plugin-message-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-plugin-message</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-plugin-file-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-plugin-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-plugin-ai-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-plugin-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
