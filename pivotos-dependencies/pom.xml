<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pivotos</groupId>
        <artifactId>pivotos-framework</artifactId>
        <version>2.16.1</version>
    </parent>

    <artifactId>pivotos-dependencies</artifactId>
    <packaging>pom</packaging>

    <name>pivotos-dependencies</name>
    <description>PivotOS BOM：全项目第三方版本唯一仲裁点</description>

    <properties>
        <!-- ==================== 核心框架 ==================== -->
        <!-- Boot 版本仲裁点已上移到父 pom（见 pivotos-framework/pom.xml），此处不再重复声明，
             以免两处漂移。升级 Boot 只改父 pom 那一行（含 spring-boot-maven-plugin 联动）。 -->

        <!-- ==================== 微服务通道（V3-S2 L2） ==================== -->
        <!-- Spring Cloud 2025.1.3：与 Boot 4.1.x 同日发布（2026-08-20）的官方对齐组合；
             官方兼容矩阵口径：Boot 4.1.x 自 SC 2025.1.2 起受支持。
             Spring Cloud Alibaba 2025.1.0.0（GA 2026-02-06）：官方绑 SC 2025.1.0 / Boot 4.0.0，
             带 Nacos client 3.1.1 / Sentinel 1.8.9 / Seata 2.5.0。
             ⚠️ 两个 BOM 必须**各自显式声明**：SCA 的 BOM 完全不管理 Spring Cloud 组件版本，
             只引 SCA 会让 SC starter 报 'version is missing' 构建失败（L1 探针实测）。
             本项目 Boot 4.1.1 > SCA 官方口径的 4.0.0，故 SC 由本项目显式钉到 2025.1.3，
             该组合已由 spike 探针实测 COMPATIBLE（Framework 7.0.9）。 -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>

        <!-- ==================== 持久层 ==================== -->
        <!-- SB4 专属 artifactId，勿用 SB3 旧 starter -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <jsqlparser.version>4.9</jsqlparser.version>
        <druid.version>1.2.28</druid.version>
        <!-- SB4 专属构件 dynamic-datasource-spring-boot4-starter：4.5.0 起适配 SB4
             （@AutoConfigureBefore 已覆盖 druid boot4 包名，exclude 规避与 TypeNotPresentException 告警同步消除） -->
        <dynamic-datasource.version>4.5.0</dynamic-datasource.version>
        <mysql-connector.version>9.7.0</mysql-connector.version>

        <!-- ==================== 认证 / 缓存 ==================== -->
        <sa-token.version>1.45.0</sa-token.version>
        <redisson.version>4.6.1</redisson.version>
        <lock4j.version>2.2.7</lock4j.version>

        <!-- ==================== 工具与序列化 ==================== -->
        <!-- Lombok：JDK 25 需 >= 1.18.40；JDK 23+ 必须配合 annotationProcessorPaths 显式开启 -->
        <lombok.version>1.18.44</lombok.version>
        <!-- fastjson2 必须 >= 2.0.61（2.0.5x 有已知 ASM 缺陷） -->
        <fastjson2.version>2.0.61</fastjson2.version>
        <!-- Jackson 2 兼容层：SB4 默认 Jackson 3，Sa-Token 仍依赖 Jackson 2，补齐 jsr310 时间模块 -->
        <jackson2.version>2.21.4</jackson2.version>
        <mapstruct-plus.version>1.5.1</mapstruct-plus.version>
        <hutool.version>5.8.47</hutool.version>

        <!-- ==================== 文档 / 任务 / 存储 ==================== -->
        <!-- Knife4j Next（SB4 社区 fork）：替代原生 Swagger UI，增强文档界面 -->
        <knife4j-next.version>5.2.4</knife4j-next.version>
        <springdoc.version>3.0.3</springdoc.version>
        <!-- Swagger Core 统一版本（knife4j / springdoc 传递依赖可能残留旧版，强制对齐） -->
        <swagger-core.version>2.2.47</swagger-core.version>
        <xxl-job.version>3.4.2</xxl-job.version>
        <minio.version>9.0.3</minio.version>
        <okhttp.version>5.3.2</okhttp.version>
        <aws-sdk-v2.version>2.49.3</aws-sdk-v2.version>

        <!-- ==================== Excel 导入导出（EasyExcel 4.x 流式） ==================== -->
        <easyexcel.version>4.0.2</easyexcel.version>

        <!-- ==================== 监控（S48 2.3-F6 服务监控 oshi 采集） ==================== -->
        <oshi.version>6.9.1</oshi.version>

        <!-- ==================== 搜索（Easy-ES 锁定 ES 7.17.28） ==================== -->
        <easy-es.version>3.0.2</easy-es.version>
        <elasticsearch.version>7.17.28</elasticsearch.version>
        <!-- es-java 实现所用的官方客户端版本（面向 ES 8.x/9.x；与服务端 9.5.3 wire 兼容） -->
        <elasticsearch-java.version>8.19.18</elasticsearch-java.version>

        <!-- ==================== AI（Spring AI 2.0：SB4.1/SF7/Jackson3 原生适配；
             SAA 1.1.2.0 仅支持 SB3.5，待其发布 SB4 版后再评估换装编排层） ==================== -->
        <spring-ai.version>2.0.0</spring-ai.version>

        <!-- ==================== 模板引擎（代码生成器） ==================== -->
        <freemarker.version>2.3.34</freemarker.version>

        <!-- ==================== 工作流引擎（WarmFlow：Dromara 社区，轻量国产，BPMN 2.0 子集） ==================== -->
        <warm-flow.version>1.8.7</warm-flow.version>

        <!-- ==================== 测试 ==================== -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <archunit.version>1.4.2</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- ========== Spring Boot 官方 BOM（import 方式，版本仲裁底座） ========== -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== Spring Cloud BOM（必须显式声明，SCA 不管 SC 版本） ========== -->
            <!-- 写在 SCA 之前：语义上表达「SC 版本由本项目决定，不被 SCA 传递的 2025.1.0 带走」 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== Spring Cloud Alibaba BOM（Nacos 3.1.1 / Sentinel 1.8.9 / Seata 2.5.0） ========== -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== MyBatis-Plus（SB4 专属 starter） ========== -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
              mybatis-plus-extension 必须显式钉到与 starter 同一个版本（S125 实测缺陷）。

              经过：warm-flow-mybatis-plus-sb4-starter 1.8.7 直接传递依赖
              com.baomidou:mybatis-plus-extension:3.5.15，而 mybatis-plus-spring-boot4-starter
              3.5.17 并不传递引入 extension 模块（3.5.17 把它拆出去了），于是 classpath 上
              extension 只有 warm-flow 带来的 3.5.15：
                · 3.5.17 的 spring.repository.CrudRepository 继承 extension.repository.AbstractRepository，
                  其 saveBatch 调用 executeBatch(Collection, int, BiFunction)（3.5.17 新增的重载）；
                · 3.5.15 的 AbstractRepository 没有这个重载
                → 运行期 NoSuchMethodError，凡走 ServiceImpl#saveBatch 的链路 100% 500
                  （实测 POST /system/user/import 恒「系统内部错误」，用户导入整条链路不可用）。

              这里显式仲裁到 ${mybatis-plus.version}，让两侧同版本。改版本时这两项必须一起动。
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
            </dependency>

            <!-- ========== Druid（SB4 专属 starter） ========== -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-4-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- ========== dynamic-datasource ========== -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot4-starter</artifactId>
                <version>${dynamic-datasource.version}</version>
            </dependency>

            <!-- ========== MySQL 驱动 ========== -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>

            <!-- ========== Sa-Token ========== -->
            <!-- TODO(S5/S6): SB4 下确认是否有 sa-token-spring-boot4-starter；
                 没有则先用 SB3 starter + 兼容性验证，必要时薄封装并记技术债 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redisson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- Redisson 核心包必须与 starter 同版本锁定，防止 sa-token-redisson / lock4j 传递进来的旧核心包抢占仲裁 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- ========== Redisson / Lock4j ========== -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>lock4j-redisson-spring-boot-starter</artifactId>
                <version>${lock4j.version}</version>
            </dependency>

            <!-- oshi 系统/硬件采集（S48 monitor 插件服务监控） -->
            <dependency>
                <groupId>com.github.oshi</groupId>
                <artifactId>oshi-core</artifactId>
                <version>${oshi.version}</version>
            </dependency>

            <!-- ========== Lombok（provided，编译期增强，不进运行时包） ========== -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
                <optional>true</optional>
            </dependency>

            <!-- ========== fastjson2（含 Spring6 扩展） ========== -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2-extension-spring6</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson2.version}</version>
            </dependency>
            <!-- Jackson 2（com.fasterxml）：ES 官方客户端的 JacksonJsonpMapper 依赖它，
                 与项目主用的 Jackson 3（tools.jackson）包名不同可共存，故单列版本不参与 Spring Boot 仲裁 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson2.version}</version>
            </dependency>

            <!-- ========== MapStruct-Plus ========== -->
            <dependency>
                <groupId>io.github.linpeilie</groupId>
                <artifactId>mapstruct-plus-spring-boot-starter</artifactId>
                <version>${mapstruct-plus.version}</version>
            </dependency>

            <!-- ========== Hutool ========== -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- ========== SpringDoc（Knife4j Next 底层依赖，版本由其托管） ========== -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- ========== Knife4j Next（SB4 兼容，社区 fork；jakarta 变体适配 SB4 的 jakarta.servlet） ========== -->
            <dependency>
                <groupId>com.baizhukui</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j-next.version}</version>
            </dependency>

            <!-- ========== Swagger Core 统一版本管理（annotations / core / models 三件套必须同版本） ========== -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-core.version}</version>
            </dependency>
            <!-- 非 jakarta 变体也锁定到 2.2.47（anthropic-java-core 传递依赖旧版 2.2.31，$dynamicRef 缺失） -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger-core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-core-jakarta</artifactId>
                <version>${swagger-core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-models-jakarta</artifactId>
                <version>${swagger-core.version}</version>
            </dependency>

            <!-- ========== XXL-Job ========== -->
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>

            <!-- ========== 对象存储：MinIO / AWS SDK v2 ========== -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!-- minio 9.x 依赖 okhttp 5（KMP 元数据包），Maven 必须显式引 okhttp-jvm 才有真实类 -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>s3</artifactId>
                <version>${aws-sdk-v2.version}</version>
            </dependency>

            <!-- ========== EasyExcel 4.x 流式 ========== -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>

            <!-- ========== Easy-ES：锁定 ES 7.17.28，防止与 Spring Data ES 冲突 ========== -->
            <dependency>
                <groupId>org.dromara.easy-es</groupId>
                <artifactId>easy-es-boot-starter</artifactId>
                <version>${easy-es.version}</version>
            </dependency>
            <!-- S121：只引 easy-es-core（含 wrapper/DSL 与底层 es-java 7.17.28），
                 刻意不引 easy-es-boot-starter —— 后者会带入 easy-es-spring（Spring Boot 2.7 基线，
                 与本项目 Spring Boot 4.1 不兼容） -->
            <dependency>
                <groupId>org.dromara.easy-es</groupId>
                <artifactId>easy-es-core</artifactId>
                <version>${easy-es.version}</version>
            </dependency>
            <!-- ⚠️ co.elastic.clients:elasticsearch-java 必须在本 BOM 显式仲裁为 es-java 实现所需的版本。
                 背景（2026-09-30 真机实测暴露）：不在 BOM 仲裁时，spring-boot-dependencies（Boot 4.1）
                 会把该坐标仲裁到 9.4.2——由于「模块内显式声明」只在模块自身构建时优先，一旦本模块作为
                 传递依赖被 admin-server 引入，就会被下游的 dependencyManagement 覆盖成 9.4.2，
                 结果是「编译/单测用 8.19.18、运行用 9.4.2」，而 9.4.2 的底层已换成 rest5-client，
                 与 EsJavaClientFactory 使用的 org.elasticsearch.client.RestClient 不是同一套。
                 故此处钉死 8.19.18（已实测可连 ES 9.5.3 服务端：服务端 minimum_wire_compatibility_version=8.19.0）。
                 easy-es 模块不受影响：它在自身 pom 里把 elasticsearch-java 显式声明为直接依赖 7.17.28，
                 「直接依赖显式版本」优先于 BOM 仲裁（已用 dependency:tree 复核）。
                 两个实现模块绝不可同时被同一应用引入。 -->
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch</groupId>
                <artifactId>elasticsearch</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-high-level-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>

            <!-- ========== Spring AI（BOM import：openai-starter 走 DashScope 兼容模式接百炼） ========== -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- S58 RAG 向量存储与文档解析（版本由 spring-ai-bom 托管，此处显式列出便于模块引用） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-vector-store</artifactId>
                <version>${spring-ai.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
                <version>${spring-ai.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-tika-document-reader</artifactId>
                <version>${spring-ai.version}</version>
            </dependency>
            <!-- S97 A2 前置：MCP Server（WebMVC SSE 形态，版本由 spring-ai-bom 托管，此处显式列出便于模块引用） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
                <version>${spring-ai.version}</version>
            </dependency>

            <!-- ========== FreeMarker 模板引擎（代码生成器） ========== -->
            <dependency>
                <groupId>org.freemarker</groupId>
                <artifactId>freemarker</artifactId>
                <version>${freemarker.version}</version>
            </dependency>

            <!-- ========== 测试 ========== -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- ========== WarmFlow 工作流引擎（SB4 + MyBatis-Plus 版本） ========== -->
            <dependency>
                <groupId>org.dromara.warm</groupId>
                <artifactId>warm-flow-mybatis-plus-sb4-starter</artifactId>
                <version>${warm-flow.version}</version>
            </dependency>
            <!-- WarmFlow 内置设计器 UI（jar 包静态资源，/warm-flow-ui/** 自动挂载） -->
            <dependency>
                <groupId>org.dromara.warm</groupId>
                <artifactId>warm-flow-plugin-ui-sb-web</artifactId>
                <version>${warm-flow.version}</version>
            </dependency>

            <!-- ========== 本项目内部模块（随会话推进逐个取消注释） ========== -->
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-common-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-excel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-datascope</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-job</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-search-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pivotos</groupId>
                <artifactId>pivotos-starter-search-easy-es</artifactId>
                <version>${project.version}</version>
            </dependency>
